<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="Geschütztes Downloadportal für DMS-Dateien." />

    <meta name="robots"
          content="noindex, nofollow, noarchive" />

    <title>@ViewData["Title"] - Grone-DMS Downloadportal</title>

    <link rel="stylesheet"
          href="@Url.Content("~/css/site.css")" />
</head>

<body>
    <header class="portal-header">
        <div class="portal-header-content">
            <a class="portal-brand"
               asp-controller="Home"
               asp-action="Index">

                <span class="portal-logo" aria-hidden="true">
                    G
                </span>

                <span class="portal-brand-text">
                    <strong>Grone-DMS</strong>
                    <small>Downloadportal</small>
                </span>
            </a>

            <div class="portal-status">
                <span class="portal-status-icon" aria-hidden="true">
                    ✓
                </span>

                <span>Geschützter Bereich</span>
            </div>
        </div>
    </header>

    <main class="portal-main">
        @RenderBody()
    </main>

    <footer class="portal-footer">
        <div class="portal-footer-content">
            <div>
                <strong>Grone-DMS Downloadportal</strong>

                <p>
                    Bereitstellung autorisierter Installationsdateien.
                </p>
            </div>

            <div class="portal-footer-meta">
                <span>
                    © @DateTime.Now.Year
                    Grone Service- und Verwaltungsgesellschaft mbH
                </span>

                <span>Verbindung über HTTPS</span>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>